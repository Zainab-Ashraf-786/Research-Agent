# Research Brief Agent Configuration
# LLM Provider: Standard OpenAI-compatible endpoint
# For Google Gemini: https://generativelanguage.googleapis.com/v1beta/openai/ (Model: gemini-2.5-flash or gemini-1.5-flash)
# For Groq: https://api.groq.com/openai/v1 (Model: llama-3.3-70b-versatile)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
LLM_MIN_INTERVAL_SECONDS=2.0

# Search Provider: Tavily API (Free tier: 1000 searches/mo)
TAVILY_API_KEY=
